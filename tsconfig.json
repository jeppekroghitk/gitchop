{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": [],
    "rootDirs": ["src", "types"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
